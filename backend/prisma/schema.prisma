// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 会社
model Company {
  id             Int      @id @default(autoincrement())
  name           String // 会社名
  nameKana       String? // 会社名（カナ）
  representative String? // 代表者名
  email          String? // 連絡先メールアドレス
  status         Boolean  @default(true) // ステータス
  postalCode     String? // 郵便番号
  prefecture     String? // 都道府県
  city           String? // 市区町村
  streetAddress  String? // それ以降の住所
  createdAt      DateTime @default(now()) // 登録日
  createdById    Int?
  updatedAt      DateTime @updatedAt // 修正日
  updatedById    Int?
  deleted        Boolean  @default(false) // 削除フラグ
  members        User[]
}

model User {
  id                    Int             @id @default(autoincrement())
  email                 String          @unique
  name                  String?
  password              String?
  department            String?
  phoneNumber           String?
  status                Boolean         @default(true)
  role                  Role            @default(MEMBER)
  createdAt             DateTime        @default(now()) // 登録日
  createdById           Int?
  updatedAt             DateTime        @updatedAt // 修正日
  updatedById           Int?
  deleted               Boolean         @default(false) // 削除フラグ
  companyId             Int
  company               Company         @relation(fields: [companyId], references: [id], map: "user_company_fk")
  invitation            Invitation?     @relation(fields: [invitationId], references: [id])
  invitationId          String?         @unique
  historyParents        HistoryParent[] @relation("UserToHistoryParent")
  updatedHistoryParents HistoryParent[] @relation("UserToHistoryParentUpdated")
  historyChildren       HistoryChild[]  @relation("UserToHistoryChild")
}

model HistoryParent {
  id    Int     @id @default(autoincrement())
  title String? // タイトル (例: 3LDK間取り提案)

  // 顧客の希望条件をJSONで保存
  conditions Json // 顧客の希望条件（ご家族構成、階数、間口、奥行き、LDK希望面積、居室数、トイレ、動線のこだわりなど）

  tags String? // タグ

  totalFavoriteCount Int @default(0) // 全子パターンの合計

  customerName String? // 顧客名
  createdAt    DateTime @default(now()) // 登録日
  createdById  Int
  createdBy    User     @relation("UserToHistoryParent", fields: [createdById], references: [id])
  updatedAt    DateTime @updatedAt // 修正日
  updatedId    Int
  updatedBy    User     @relation("UserToHistoryParentUpdated", fields: [updatedId], references: [id])
  deleted      Boolean  @default(false) // 削除フラグ

  children HistoryChild[]
  generationJobs FloorPlanGenerationJob[]
}

// 履歴子テーブル
model HistoryChild {
  // 固有ID (プライマリキー)
  id Int @id @default(autoincrement())

  historyParentId Int // 親ID
  historyParent   HistoryParent @relation(fields: [historyParentId], references: [id], map: "history_child_parent_fk")

  // 間取りパターン詳細情報
  patternName String? // 【追加】パターン名 (例: パターンA - スタンダード)

  // 【統合】間取り図データと詳細情報を一つのJSONに
  floorplanData Json // 【統合】間取り図の幾何学データとパターン詳細（LDKサイズ、特徴タグなど）をまとめて保存するJSON

  // お気に入りに関する修正
  isPatternFavorite Boolean @default(false) // 【名称変更】ログインユーザーによる特定パターンのお気に入り

  // 既存項目とプレビュー情報 (image_1f139f.png)
  tag              String? // タグ (汎用)
  isDownloaded     Boolean @default(false) // ダウンロード有無
  pdfPath          String? // PDFデータパス
  constructionName String? // 工事名称
  scale            String? // 縮尺
  drawingFormat    String? // 図面形式

  createdAt   DateTime @default(now()) // 登録日
  createdById Int
  createdBy   User     @relation("UserToHistoryChild", fields: [createdById], references: [id])
  deleted     Boolean  @default(false) // 削除フラグ
}

// ユーザー招待を管理するモデル
model Invitation {
  id         String    @id @default(cuid())
  email      String    @unique
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User?
}

// 役割(Role)を更新
enum Role {
  MEMBER // 一般メンバー
  COMPANY_ADMIN // 会社管理者
  SYSTEM_ADMIN // システム全体管理者
}

model FloorPlanGenerationJob {
  jobId           String    @id @unique @map("job_id") // FEに返すジョブID
  status          String    @default("processing") // processing, completed, failed
  progress        Int       @default(0) // 0-100の整数、進行率（％）
  estimatedTime   String?   @map("estimated_time") // 予想残り時間（秒単位など）
  requestPayload  Json      @map("request_payload") // 間取り生成リクエストのボディ（layout_conditionsなど）
  resultPayload   Json?     @map("result_payload") // Pythonからの生成結果（plans配列）
  errorMessage    String?   @map("error_message") // エラーメッセージ
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  completedAt     DateTime? @map("completed_at") // 完了日時
  historyParentId Int?      @map("history_parent_id") // 完了後に関連するHistoryParentのID
  historyParent   HistoryParent? @relation(fields: [historyParentId], references: [id])
}
